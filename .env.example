# Runtime
PORT=20664
NODE_ENV=production

# Automatic actions are disabled by default for account and group safety.
AUTO_VIEW_STATUS=false
AUTO_LIKE_STATUS=false
AUTO_FOLLOW_NEWSLETTERS=false
AUTO_JOIN_GROUPS=false
ENABLE_PRANK_COMMANDS=false

# Optional group broadcast controls.
MAX_BROADCAST_GROUPS=10
BROADCAST_DELAY_MS=5000

# Anti-hijack enforcement is controlled per group with .antihijack on/off.
# Keep unset unless explicitly required.
# ANTIHIJACK_DEFAULT=false
